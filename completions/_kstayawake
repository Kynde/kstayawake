#compdef kstayawake
# zsh completion for kstayawake (bin/kstayawake in the `kstayawake` repo).
# Keep this file in sync with the subcommands in bin/kstayawake.
# Install: symlink into a dir on $fpath, e.g.
#   ln -s ~/kstayawake/completions/_kstayawake ~/.zsh/completion/_kstayawake
# then restart zsh (or: rm -f ~/.zcompdump*; compinit).

_kstayawake() {
  local -a subcmds=(
    'off:restore normal power settings now; suspend if the lid is closed'
    'stop:alias for off'
    'status:show whether armed and the time remaining (default)'
    'tui:live full-screen countdown (optionally: tui N to arm first)'
    'help:show this help'
  )
  local -a opts=(
    '--status:show whether armed and the time remaining'
    '--help:show this help'
    '-h:show this help'
  )

  # At most two words: `tui N` or `N tui`; offer nothing past the second.
  (( CURRENT > 3 )) && return 0
  if (( CURRENT == 3 )); then
    case $words[2] in
      tui)      _message -e minutes 'minutes to stay awake, then open the tui' ;;
      <1->)     local -a after=('tui:open the live countdown after arming')
                _describe -t commands 'command' after ;;
    esac
    return 0
  fi

  _describe -t commands 'command' subcmds
  _describe -t options 'option' opts
  _message -e minutes 'minutes to stay awake (positive integer)'
}

_kstayawake "$@"
